# Server
PORT=5000
NODE_ENV=development

# Databases
# Local dev uses the Docker Compose MongoDB/Redis on their HOST ports
# (27018/6380 — chosen to avoid conflicts with other projects using
# 27017/6379). Inside Docker Compose the backend uses service names instead:
#   mongodb://mongodb:27017/doseque  and  redis://redis:6379
MONGODB_URI=mongodb://127.0.0.1:27018/doseque
REDIS_URL=redis://127.0.0.1:6380

# Allowed frontend origin (CORS)
FRONTEND_URL=http://localhost:5173
